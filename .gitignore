build/
!gradle/wrapper/gradle-wrapper.jar

# Cargo build output. Note Cargo.lock IS committed (see iroh4k/src/rust/.gitignore)
# so the exact iroh patch version is reproducible across targets and CI.
target/

# cargo-ndk output, rebuilt from source
iroh4k/src/androidMain/jniLibs/

# JVM fatal-error logs. Note release builds set strip=true, so any such log has useless
# symbol attribution — rebuild with strip=false + debug=true before trying to read one.
hs_err_pid*.log
replay_pid*.log

